<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono de la app (adaptive icon foreground).

  Lienzo de 108x108; la bolsa se dibuja en un path de 24x24 escalado al área
  segura central (66 dp): escala 2.75 y traslación 21 en ambos ejes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2.75"
        android:scaleY="2.75"
        android:translateX="21"
        android:translateY="21">

        <!-- Cuerpo de la bolsa. -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M5,8 L19,8 L19,20 C19,20.83 18.33,21.5 17.5,21.5 L6.5,21.5 C5.67,21.5 5,20.83 5,20 Z" />

        <!-- Asa de la bolsa. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:pathData="M9,8 L9,6.5 A3,3 0 0 1 15,6.5 L15,8" />
    </group>
</vector>
